APP_URL=http://localhost:3000
DATABASE_URL=postgresql://file_mcp:password@localhost:5432/file_mcp
# Only use the privileged URL when running db:migrate.
DATABASE_MIGRATOR_URL=
DASHBOARD_SECRET=
SESSION_SIGNING_SECRET=
# 32 random bytes encoded as base64; used for AES-256-GCM.
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register APP_URL/api/google/callback as an exact OAuth redirect URI.
GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/drive
# Optional PEM certificate for the PostgreSQL provider.
PG_CA=
