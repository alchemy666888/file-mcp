+import { describe,it,expect,vi } from "vitest";
+import { fileMcpWorkerEnvironment } from "../../../../src/server/file-mcp/delegation";
+const env={FILE_MCP_ENABLED:"true",FILE_MCP_ALLOW_USERS:"123",FILE_MCP_TOOLS:"drive_list_roots",FILE_MCP_URL:"https://file-mcp.example/api/mcp",FILE_MCP_API_KEY:"k".repeat(43)};
+describe("File MCP server delegation",()=>{
+  it("does not contact MCP for unapproved users",async()=>{const request=vi.fn();expect(await fileMcpWorkerEnvironment("999",env,request)).toEqual({FILE_MCP_ENABLED:"false"});expect(request).not.toHaveBeenCalled();});
+  it("passes only a scoped session to the worker",async()=>{const request=vi.fn().mockResolvedValue(Response.json({token:"s".repeat(43),expiresAt:new Date(Date.now()+300000).toISOString()}));const result=await fileMcpWorkerEnvironment("123",env,request);expect(result.FILE_MCP_SESSION).toBe("s".repeat(43));expect(result).not.toHaveProperty("FILE_MCP_API_KEY");expect(JSON.stringify(result)).not.toContain(env.FILE_MCP_API_KEY);expect(JSON.parse(request.mock.calls[0][1].body)).toEqual({tools:["drive_list_roots"],ttlSeconds:300});});
+  it("rejects unknown tool names",async()=>{await expect(fileMcpWorkerEnvironment("123",{...env,FILE_MCP_TOOLS:"arbitrary_tool"},vi.fn())).rejects.toThrow("FILE_MCP_TOOLS_INVALID");});
