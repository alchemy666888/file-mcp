diff --git a/src/server/file-mcp/delegation.ts b/src/server/file-mcp/delegation.ts
new file mode 100644
index 0000000..0d08843
--- /dev/null
+++ b/src/server/file-mcp/delegation.ts
@@ -0,0 +1,19 @@
+import "server-only";
+import { z } from "zod";
+import catalog from "../../worker/capabilities/file-mcp-catalog.json";
+/** Only a selected Telegram user gets a short-lived MCP session. Never pass the permanent key to the worker. */
+export async function fileMcpWorkerEnvironment(userId:string,env:Record<string,string|undefined>=process.env,request:typeof fetch=fetch):Promise<Record<string,string>>{
+  const disabled={FILE_MCP_ENABLED:"false"};
+  if(env.FILE_MCP_ENABLED!=="true")return disabled;
+  const allowed=(env.FILE_MCP_ALLOW_USERS??"").split(",").map(value=>value.trim());if(!allowed.includes(userId))return disabled;
+  const selected=(env.FILE_MCP_TOOLS??"").split(",").map(value=>value.trim()).filter(Boolean);
+  if(!selected.length||selected.some(name=>!catalog.some(tool=>tool.name===name)))throw new Error("FILE_MCP_TOOLS_INVALID");
+  const url=new URL(env.FILE_MCP_URL??"");
+  if((url.protocol!=="https:"&&!(url.protocol==="http:"&&url.hostname==="localhost"&&!env.VERCEL))||url.pathname!=="/api/mcp"||url.username||url.password||url.search||url.hash)throw new Error("FILE_MCP_URL_INVALID");
+  if(!env.FILE_MCP_API_KEY||!/^[A-Za-z0-9_-]{43}$/.test(env.FILE_MCP_API_KEY))throw new Error("FILE_MCP_API_KEY_INVALID");
+  const endpoint=new URL("/api/delegations",url);
+  const response=await request(endpoint,{method:"POST",headers:{authorization:`Bearer ${env.FILE_MCP_API_KEY}`,"content-type":"application/json"},body:JSON.stringify({tools:selected,ttlSeconds:300}),signal:AbortSignal.timeout(10_000),redirect:"error",cache:"no-store"});
+  if(!response.ok){await response.body?.cancel();throw new Error("FILE_MCP_DELEGATION_UNAVAILABLE");}
+  const session=z.object({token:z.string().regex(/^[A-Za-z0-9_-]{43}$/),expiresAt:z.string()}).parse(await response.json());
+  return {FILE_MCP_ENABLED:"true",FILE_MCP_URL:url.href,FILE_MCP_TOOLS:selected.join(","),FILE_MCP_SESSION:session.token};
+}
