@@ -0,0 +1,32 @@
+import { z } from "zod";
+import catalog from "./file-mcp-catalog.json";
+import type { CapabilityDefinition } from "./registry";
+const PROTOCOL="2025-11-25";
+export function fileMcpDefinitions(env:Record<string,string|undefined>=process.env,request:typeof fetch=fetch):CapabilityDefinition[]{
+  if(env.FILE_MCP_ENABLED!=="true")return [];
+  const selected=new Set((env.FILE_MCP_TOOLS??"").split(",").map(value=>value.trim()).filter(Boolean));
+  return catalog.filter(tool=>selected.has(tool.name)).map(tool=>({
+    scope:"general",request:{id:tool.name,description:tool.description,inputSchema:tool.inputSchema},
+    input:z.record(z.string(),z.unknown()),timeoutMs:60_000,
+    async execute(args,signal){
+      if(!env.FILE_MCP_SESSION)throw new Error("FILE_MCP_SESSION_UNAVAILABLE");
+      const url=new URL(env.FILE_MCP_URL??"");
+      if((url.protocol!=="https:"&&!(url.protocol==="http:"&&url.hostname==="localhost"&&!env.VERCEL))||url.pathname!=="/api/mcp"||url.username||url.password||url.search||url.hash)throw new Error("FILE_MCP_URL_INVALID");
+      const headers={authorization:`Bearer ${env.FILE_MCP_SESSION}`,"content-type":"application/json",accept:"application/json, text/event-stream","mcp-protocol-version":PROTOCOL};
+      async function rpc(method:string,params?:unknown,id?:number){
+        const response=await request(url,{method:"POST",headers,body:JSON.stringify({jsonrpc:"2.0",...(id===undefined?{}:{id}),method,params}),signal,redirect:"error",cache:"no-store"});
+        if(!response.ok){await response.body?.cancel();const error=new Error("FILE_MCP_UNAVAILABLE") as Error&{status:number};error.status=response.status;throw error;}
+        if(id===undefined){await response.body?.cancel();return undefined;}
+        const payload=await response.json();if(payload.error)throw new Error("FILE_MCP_PROTOCOL_ERROR");return payload.result;
+      }
+      const initialized=await rpc("initialize",{protocolVersion:PROTOCOL,capabilities:{},clientInfo:{name:"agent-bot",version:"0.1.0"}},1);
+      if(initialized?.protocolVersion!==PROTOCOL)throw new Error("FILE_MCP_PROTOCOL_MISMATCH");
+      await rpc("notifications/initialized");
+      const result=await rpc("tools/call",{name:tool.name,arguments:args},2);
+      const parsed=z.object({isError:z.boolean().optional(),structuredContent:z.object({data:z.unknown().optional(),error:z.string().optional()})}).safeParse(result);
+      if(!parsed.success)throw new Error("FILE_MCP_RESULT_INVALID");
+      if(parsed.data.isError)throw new Error(`FILE_MCP_TOOL_ERROR:${parsed.data.structuredContent.error??"UNKNOWN"}`);
+      return parsed.data.structuredContent.data;
+    }
+  }));
+}
